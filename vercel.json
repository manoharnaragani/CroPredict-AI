{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/predict/yield",
      "destination": "/api/predict/yield"
    },
    {
      "source": "/api/detect/disease",
      "destination": "/api/detect/disease"
    },
    {
      "source": "/api/models/status",
      "destination": "/api/models/status"
    },
    {
      "source": "/api/smart-optimization",
      "destination": "/api/smart-optimization"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
